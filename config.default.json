{
  "_note": "Ploinky Workers defaults. User configuration and API keys live in ~/.pworker. Tiers select providers and models; local servers can start on demand.",
  "server": {
    "host": "127.0.0.1",
    "port": 18080
  },
  "dataDir": "~/.pworker/data",
  "cacheDir": "~/.pworker/cache",
  "auditDir": "~/.pworker/audit",
  "logDir": "~/.pworker/logs",
  "promptsDir": "prompts",
  "defaultUpstream": "openference",
  "injectStreamUsage": true,
  "modelsCacheSeconds": 600,
  "providers": {
    "openference": {
      "baseUrl": "https://api.openference.com",
      "envFile": "openference.env",
      "keyVar": "OPENFERENCE_API_KEY",
      "baseUrlVar": "OPENFERENCE_BASE_URL",
      "modelsPath": "/v1/models",
      "creditBalanceModels": [
        "Kimi K2.6"
      ],
      "_creditBalanceModelsNote": "Known models that require a separate provider credit balance. Pworker excludes these from automatic tier suggestions and returns an actionable error before sending a request.",
      "formats": {
        "openai": "/v1/chat/completions",
        "anthropic": "/v1/messages"
      },
      "limits": {
        "maxConcurrent": 4,
        "maxPerSecond": 5,
        "maxPerMinute": 15,
        "maxPerHour": 800,
        "pacing": "even",
        "safetyMargin": 0,
        "windowSlackMs": 1500,
        "abortHoldMs": 30000,
        "adaptive": {
          "decrease": 0.7,
          "min": 0.2,
          "cooldownMs": 300000,
          "increase": 0.1
        }
      },
      "retry": {
        "max": 4,
        "baseMs": 1000,
        "maxWaitMs": 60000,
        "max5xx": 2
      },
      "plan": {
        "priceUsdPerMonth": 15,
        "_note": "15 requests per minute; about 400 plan credits per 5 hours and 7,500 per week; a call costs its model's quota_multiplier (x-quota-cost).",
        "limits": [
          {
            "name": "per_minute",
            "unit": "calls",
            "window": "60s",
            "max": 15,
            "provider": {
              "remainingHeader": "x-ratelimit-remaining",
              "resetHeader": "x-ratelimit-reset"
            }
          },
          {
            "name": "per_5h",
            "unit": "credits",
            "window": "5h",
            "max": 400,
            "provider": {
              "remainingHeader": "x-quota-remaining",
              "costHeader": "x-quota-cost"
            }
          },
          {
            "name": "per_week",
            "unit": "credits",
            "window": "7d",
            "max": 7500
          }
        ]
      },
      "_limitsNote": "15 requests per minute are sent one every 4 s (pacing even), with 1.5 s of window slack for network jitter. A 429 pauses the provider for its full Retry-After and lowers the rate by the adaptive factor, which recovers by 0.1 every 5 minutes without a 429. An attempt aborted after it was sent keeps its slot for 30 s. See docs/rate-limits.md."
    },
    "openrouter": {
      "baseUrl": "https://openrouter.ai/api",
      "envFile": "openrouter.env",
      "keyVar": "OPENROUTER_API_KEY",
      "modelsPath": "/v1/models?sort=most-popular&limit=60",
      "_modelsNote": "Pworker requests the current top 60 popular OpenRouter models, rather than the whole catalog. The interactive picker can then sort that live list by published price or creation date.",
      "formats": {
        "openai": "/v1/chat/completions"
      },
      "limits": {
        "maxConcurrent": 8,
        "maxPerSecond": 5,
        "maxPerMinute": 120,
        "maxPerHour": 3000,
        "windowSlackMs": 1000,
        "abortHoldMs": 15000
      },
      "retry": {
        "max": 4,
        "baseMs": 1000,
        "maxWaitMs": 60000
      }
    },
    "deepseek": {
      "baseUrl": "https://api.deepseek.com",
      "envFile": "deepseek.env",
      "keyVar": "DEEPSEEK_API_KEY",
      "modelsPath": "/v1/models",
      "formats": {
        "openai": "/v1/chat/completions"
      },
      "limits": {
        "maxConcurrent": 8,
        "maxPerSecond": 5,
        "maxPerMinute": 120,
        "maxPerHour": 3000,
        "windowSlackMs": 1000,
        "abortHoldMs": 15000
      },
      "retry": {
        "max": 4,
        "baseMs": 1000,
        "maxWaitMs": 60000
      },
      "modelLimits": {
        "deepseek-flash": {
          "contextTokens": 1000000,
          "maxOutputTokens": 393216,
          "defaultOutputTokens": 65536,
          "source": "https://api-docs.deepseek.com/api/create-chat-completion/",
          "verifiedAt": "2026-10-06"
        }
      }
    },
    "local": {
      "_note": "Local tiny model: Qwen3.6-35B-A3B, eight slots of 16k tokens, started on demand.",
      "baseUrl": "http://127.0.0.1:19611",
      "noKey": true,
      "modelsPath": "/v1/models",
      "formats": {
        "openai": "/v1/chat/completions"
      },
      "limits": {
        "maxPerSecond": 50,
        "maxPerMinute": 3000,
        "maxPerHour": 100000
      },
      "retry": {
        "max": 0,
        "max5xx": 0,
        "baseMs": 500,
        "maxWaitMs": 5000
      },
      "start": {
        "bin": "llama-server",
        "gguf": "~/.pworker/models/Qwen3.6-35B-A3B-UD-Q4_K_M.gguf",
        "alias": "Qwen3.6-35B-A3B",
        "slots": 8,
        "ctxPerSlot": 16384,
        "args": [
          "-ngl",
          "99",
          "-fa",
          "on",
          "--jinja",
          "--no-webui"
        ],
        "requireFreeGpu": false,
        "startTimeoutMs": 300000,
        "idleStopMs": 0,
        "startAtBoot": false
      }
    },
    "localsuper": {
      "_note": "Local micro model: Qwen3-4B-Instruct-2507, started on demand and stopped after 15 idle minutes.",
      "baseUrl": "http://127.0.0.1:19613",
      "noKey": true,
      "modelsPath": "/v1/models",
      "formats": {
        "openai": "/v1/chat/completions"
      },
      "limits": {
        "maxPerSecond": 200,
        "maxPerMinute": 6000,
        "maxPerHour": 200000
      },
      "retry": {
        "max": 0,
        "max5xx": 0,
        "baseMs": 500,
        "maxWaitMs": 5000
      },
      "start": {
        "bin": "llama-server",
        "gguf": "~/.pworker/models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf",
        "alias": "Qwen3-4B",
        "slots": 32,
        "ctxPerSlot": 4096,
        "args": [
          "-ngl",
          "99",
          "-fa",
          "on",
          "--jinja",
          "--no-webui",
          "--cache-reuse",
          "256"
        ],
        "requireFreeGpu": false,
        "startTimeoutMs": 120000,
        "idleStopMs": 900000,
        "startAtBoot": false
      }
    },
    "localnano": {
      "_note": "nano: Qwen3-0.6B (Q8_0), on demand, stopped after 15 idle minutes, 32 slots; the smallest and fastest local model.",
      "baseUrl": "http://127.0.0.1:19614",
      "noKey": true,
      "modelsPath": "/v1/models",
      "formats": {
        "openai": "/v1/chat/completions"
      },
      "limits": {
        "maxPerSecond": 200,
        "maxPerMinute": 6000,
        "maxPerHour": 200000
      },
      "retry": {
        "max": 0,
        "max5xx": 0,
        "baseMs": 500,
        "maxWaitMs": 5000
      },
      "start": {
        "bin": "llama-server",
        "gguf": "~/.pworker/models/Qwen3-0.6B-Q8_0.gguf",
        "alias": "Qwen3-0.6B",
        "slots": 32,
        "ctxPerSlot": 4096,
        "args": [
          "-ngl",
          "99",
          "-fa",
          "on",
          "--jinja",
          "--no-webui",
          "--cache-reuse",
          "256"
        ],
        "requireFreeGpu": false,
        "startTimeoutMs": 120000,
        "idleStopMs": 900000,
        "startAtBoot": false
      }
    },
    "local-llm": {
      "_note": "The engine of lib/local-llm-host: one model at a time, started with `pworker models run <id>` (weights are downloaded there, never by a chat request), served over a Unix socket. No tier uses it by default; add it to a tier with `{ \"upstream\": \"local-llm\", \"model\": \"<catalog id>\" }`.",
      "kind": "local-llm",
      "baseUrl": "http://localhost",
      "noKey": true,
      "modelsPath": "/v1/models",
      "formats": {
        "openai": "/v1/chat/completions"
      },
      "limits": {
        "maxConcurrent": 1
      },
      "retry": {
        "max": 0,
        "max5xx": 0,
        "baseMs": 500,
        "maxWaitMs": 5000
      }
    },
    "openai": {
      "baseUrl": "https://api.openai.com",
      "envFile": "openai.env",
      "keyVar": "OPENAI_API_KEY",
      "modelsPath": "/v1/models",
      "formats": {
        "openai": "/v1/chat/completions"
      },
      "limits": {
        "maxConcurrent": 4,
        "maxPerMinute": 60,
        "windowSlackMs": 1000,
        "abortHoldMs": 15000
      }
    },
    "zai": {
      "baseUrl": "https://api.z.ai/api/paas/v4",
      "envFile": "zai.env",
      "keyVar": "PWORKER_ZAI_API_KEY",
      "modelsPath": "/models",
      "formats": {
        "openai": "/chat/completions"
      },
      "limits": {
        "maxConcurrent": 4,
        "maxPerMinute": 60,
        "windowSlackMs": 1000,
        "abortHoldMs": 15000
      }
    },
    "grok": {
      "baseUrl": "https://api.x.ai",
      "envFile": "grok.env",
      "keyVar": "PWORKER_GROK_API_KEY",
      "modelsPath": "/v1/models",
      "formats": {
        "openai": "/v1/chat/completions"
      },
      "limits": {
        "maxConcurrent": 4,
        "maxPerMinute": 60,
        "windowSlackMs": 1000,
        "abortHoldMs": 15000
      }
    }
  },
  "tiers": {
    "_note": "Clients request a tier rather than a concrete model. Remote models are selected from each provider's live catalog in pworker; no remote model ID is pinned here. Each tier is an ordered provider/model chain. Providers without keys are skipped; local models can serve when configured.",
    "maxWaitMs": 120000,
    "nano": [
      {
        "upstream": "localnano",
        "model": "Qwen3-0.6B"
      }
    ],
    "micro": [
      {
        "upstream": "localsuper",
        "model": "Qwen3-4B"
      },
      {
        "upstream": "local",
        "model": "Qwen3.6-35B-A3B"
      }
    ],
    "supertiny": "micro",
    "tiny": [
      {
        "upstream": "local",
        "model": "Qwen3.6-35B-A3B"
      }
    ],
    "small": [
      {
        "upstream": "local",
        "model": "Qwen3.6-35B-A3B"
      }
    ],
    "medium": [
      {
        "upstream": "local",
        "model": "Qwen3.6-35B-A3B"
      }
    ],
    "good": [
      {
        "upstream": "local",
        "model": "Qwen3.6-35B-A3B"
      }
    ],
    "best": [
      {
        "upstream": "local",
        "model": "Qwen3.6-35B-A3B"
      }
    ]
  },
  "fallback": null,
  "audit": {
    "enabled": true,
    "tiers": [
      "tiny",
      "small",
      "medium"
    ],
    "upstreams": [
      "local"
    ],
    "maxBytesPerDay": 209715200,
    "maxDays": 14,
    "maxCharsPerField": 200000
  },
  "policy": {
    "allowedPurposes": [
      "chat",
      "formalize",
      "answer-*",
      "ingest",
      "job:*",
      "review:*",
      "run:*",
      "test:*",
      "pworker:*"
    ],
    "untaggedDailyMax": 100,
    "keepDays": 7
  },
  "interactive": {
    "purposes": [
      "chat",
      "formalize",
      "answer-*"
    ],
    "maxWaitMs": 15000
  },
  "cache": {
    "defaultMode": "use"
  },
  "run": {
    "budget": {
      "usd": 0.5,
      "credits": 60,
      "calls": 300
    },
    "maxSteps": 5
  },
  "sandbox": {
    "timeMs": 120000,
    "heapMb": 128,
    "maxCalls": 50,
    "maxCodeBytes": 20000,
    "maxOutputBytes": 1000000,
    "tiers": [
      "nano",
      "micro",
      "tiny",
      "small",
      "medium"
    ]
  },
  "background": {
    "share": 0.7,
    "purposes": [],
    "_note": "Background work is queued behind interactive requests and stays within its configured share of rate limits."
  },
  "batching": {
    "nano": {
      "enabled": false
    },
    "micro": {
      "enabled": false
    },
    "tiny": {
      "enabled": false
    },
    "small": {
      "enabled": false
    },
    "medium": {
      "enabled": false
    },
    "good": {
      "enabled": false
    },
    "best": {
      "enabled": false
    }
  }
}
